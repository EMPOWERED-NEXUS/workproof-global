NODE_ENV=development
PORT=4000

# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql://workproof:workproof_dev_password@localhost:5434/workproof?schema=public

# Test database (isolated)
TEST_DATABASE_URL=postgresql://workproof:workproof_dev_password@localhost:5434/workproof_test?schema=public

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# JWT secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Cookie settings
COOKIE_NAME=workproof_token
COOKIE_SECURE=false

# Verification token expiry (hours)
VERIFICATION_TOKEN_EXPIRY_HOURS=72

# Upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
