NODE_ENV=development
PORT=4000

# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql://workproof:workproof_dev_password@localhost:5434/workproof?schema=public

# Test database (isolated)
TEST_DATABASE_URL=postgresql://workproof:workproof_dev_password@localhost:5434/workproof_test?schema=public

# Trusted database CA PEM for production Supabase pooler TLS (required when host is *.pooler.supabase.com).
# Prefer injecting via secret manager. Do not commit real certificate material.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Browser origins (comma-separated allow-list). FRONTEND_URL remains the primary app origin.
FRONTEND_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access tokens (short-lived JWT). Use a long random secret in production (min 32 chars).
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Cookie settings
ACCESS_COOKIE_NAME=workproof_access
REFRESH_COOKIE_NAME=workproof_refresh
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Docs (must be explicitly true to mount Swagger)
ENABLE_API_DOCS=true

# Proxy hops trusted by Express
TRUST_PROXY=1

# JWT issuer / audience
JWT_ISSUER=workproof-api
JWT_AUDIENCE=workproof-clients

# Customer verification token expiry (hours)
VERIFICATION_TOKEN_EXPIRY_HOURS=72

# Evidence storage
# local = development/test only (forbidden in production)
# supabase = private bucket via service-role key (API only)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=uploads
# UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
SIGNED_URL_EXPIRY_SECONDS=120

# Supabase Storage (API server only — never put these in web/mobile)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<set-in-secret-manager>
SUPABASE_STORAGE_BUCKET=workproof-evidence

# Email delivery
# console = local/test only (forbidden in production)
# transactional = HTTP provider (Resend-compatible) via EMAIL_API_URL + EMAIL_API_KEY
EMAIL_PROVIDER=console
EMAIL_FROM=WorkProof Global <noreply@workproof.local>
# EMAIL_REPLY_TO=support@workproof.local
SUPPORT_EMAIL=support@workproof.local
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=<set-in-secret-manager>
# Dedicated 64-hex (32-byte) key — must NOT reuse ACCESS_TOKEN_SECRET
# EMAIL_PAYLOAD_ENCRYPTION_KEY=<generate-a-dedicated-64-hex-secret>
EMAIL_JOB_POLL_INTERVAL_MS=5000
EMAIL_JOB_MAX_ATTEMPTS=8
EMAIL_JOB_PROCESSING_TIMEOUT_MS=120000
EMAIL_VERIFICATION_EXPIRY_HOURS=48
EMAIL_RESEND_COOLDOWN_SECONDS=60
CUSTOMER_VERIFICATION_RESEND_COOLDOWN_SECONDS=120

# Password reset
PASSWORD_RESET_EXPIRY_HOURS=1

# Return raw tokens in API responses (local/test only — never in staging/production)
ALLOW_DEV_VERIFICATION_TOKEN=true
ALLOW_DEV_PASSWORD_RESET_TOKEN=true
