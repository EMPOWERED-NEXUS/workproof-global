NODE_ENV=development
PORT=4000

# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql://workproof:workproof_dev_password@localhost:5434/workproof?schema=public

# Test database (isolated)
TEST_DATABASE_URL=postgresql://workproof:workproof_dev_password@localhost:5434/workproof_test?schema=public

# Browser origins (comma-separated allow-list). FRONTEND_URL remains the primary app origin.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access tokens (short-lived JWT). Use a long random secret in production (min 32 chars).
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Cookie settings
ACCESS_COOKIE_NAME=workproof_access
REFRESH_COOKIE_NAME=workproof_refresh
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Docs (must be explicitly true to mount Swagger)
ENABLE_API_DOCS=true

# Proxy hops trusted by Express
TRUST_PROXY=1

# JWT issuer / audience
JWT_ISSUER=workproof-api
JWT_AUDIENCE=workproof-clients

# Verification token expiry (hours)
VERIFICATION_TOKEN_EXPIRY_HOURS=72

# Upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
