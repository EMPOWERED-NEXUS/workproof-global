generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WORKER
  ORGANISATION
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// ARCHIVED retained temporarily for migration compatibility only.
/// New code must never write ARCHIVED; use archivedAt instead.
enum ReceiptStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  CORRECTION_REQUESTED
  DISPUTED
  REVOKED
  ARCHIVED
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum EvidenceType {
  IMAGE
  DOCUMENT
  LINK
}

enum ConfirmationDecision {
  CONFIRMED
  CORRECTION_REQUESTED
  DISPUTED
}

/// How the customer was invited to confirm. Distinct from evidence.
enum ConfirmationMethod {
  EMAIL
  SHARE_LINK
  IN_PERSON_QR
}

/// Who may see an evidence item. Supporting evidence never verifies a receipt alone.
enum EvidenceVisibility {
  CUSTOMER_ONLY
  PUBLIC_PROOF
}

enum DurationUnit {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum ReceiptEventActorType {
  WORKER
  CUSTOMER
  ADMIN
  SYSTEM
}

enum StorageProvider {
  LOCAL
  SUPABASE
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EmailJobType {
  EMAIL_VERIFICATION
  CUSTOMER_VERIFICATION
  CUSTOMER_VERIFICATION_RESEND
  DELIVERY_FAILURE_NOTICE
  PASSWORD_RESET
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  role            UserRole   @default(WORKER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  termsAcceptedAt   DateTime?  @map("terms_accepted_at")
  privacyAcceptedAt DateTime?  @map("privacy_accepted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  workerProfile            WorkerProfile?
  organisation             Organisation?
  receipts                 WorkReceipt[]            @relation("WorkerReceipts")
  revokedReceipts          WorkReceipt[]            @relation("ReceiptRevokedBy")
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  receiptEvents            ReceiptEvent[]
  resolvedDisputes         Dispute[]                @relation("DisputeResolvedBy")
  uploadedEvidence         Evidence[]               @relation("EvidenceUploadedBy")
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  claimedAt     DateTime? @map("claimed_at")
  usedAt        DateTime? @map("used_at")
  invalidatedAt DateTime? @map("invalidated_at")
  requestedIp   String?   @map("requested_ip")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime? @map("last_used_at")
  deviceName        String?   @map("device_name")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model WorkerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  headline    String?
  bio         String?
  location    String?
  phone       String?
  skills      String[] @default([])
  profileSlug String   @unique @map("profile_slug")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_profiles")
}

model Organisation {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @unique @map("owner_id") @db.Uuid
  name        String
  description String?
  website     String?
  location    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("organisations")
}

model WorkReceipt {
  id                 String        @id @default(uuid()) @db.Uuid
  receiptNumber      String?       @unique @map("receipt_number")
  workerId           String        @map("worker_id") @db.Uuid
  customerName       String              @map("customer_name")
  customerEmail      String?             @map("customer_email")
  customerPhone      String?             @map("customer_phone")
  confirmationMethod ConfirmationMethod  @default(EMAIL) @map("confirmation_method")
  /// Method that produced the successful customer confirmation (null until verified).
  confirmedMethod    ConfirmationMethod? @map("confirmed_method")
  serviceTitle       String              @map("service_title")
  description        String
  workDate           DateTime            @map("work_date") @db.Date
  /// Legacy minutes field retained for compatibility. Prefer durationValue + durationUnit.
  durationMinutes    Int?                @map("duration_minutes")
  durationValue      Decimal?            @map("duration_value") @db.Decimal(10, 2)
  durationUnit       DurationUnit?       @map("duration_unit")
  amount             Decimal?            @db.Decimal(12, 2)
  currency           String              @default("XAF")
  skillsDemonstrated String[]            @default([]) @map("skills_demonstrated")
  status             ReceiptStatus       @default(DRAFT)
  visibility         Visibility          @default(PRIVATE)
  verificationCode   String?       @unique @map("verification_code")
  integrityHash      String?       @map("integrity_hash")
  integrityVersion   Int?          @map("integrity_version")
  submittedAt        DateTime?     @map("submitted_at")
  verifiedAt         DateTime?     @map("verified_at")
  lockedAt           DateTime?     @map("locked_at")
  archivedAt         DateTime?     @map("archived_at")
  revokedAt          DateTime?     @map("revoked_at")
  revokedById        String?       @map("revoked_by_id") @db.Uuid
  revocationReason   String?       @map("revocation_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  worker               User                  @relation("WorkerReceipts", fields: [workerId], references: [id], onDelete: Cascade)
  revokedBy            User?                 @relation("ReceiptRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  evidence             Evidence[]
  verificationRequests VerificationRequest[]
  confirmations        Confirmation[]
  dispute              Dispute?
  events               ReceiptEvent[]
  auditLogs            AuditLog[]

  @@index([workerId])
  @@index([status])
  @@index([workDate])
  @@index([archivedAt])
  @@map("work_receipts")
}

/// Evidence file identity is storageKey (or externalUrl for LINK).
/// Legacy `url` is retained only for migration safety and will be removed in a later wave.
model Evidence {
  id               String             @id @default(uuid()) @db.Uuid
  receiptId        String             @map("receipt_id") @db.Uuid
  type             EvidenceType
  /// @deprecated Prefer storageKey / externalUrl. Do not write file storage URLs here.
  url              String?
  storageProvider  StorageProvider?   @map("storage_provider")
  storageBucket    String?            @map("storage_bucket")
  storageKey       String?            @map("storage_key")
  externalUrl      String?            @map("external_url")
  linkPlatform     String?            @map("link_platform")
  visibility       EvidenceVisibility @default(CUSTOMER_ONLY)
  originalFilename String?            @map("original_filename")
  safeFilename     String?            @map("safe_filename")
  mimeType         String?            @map("mime_type")
  size             Int?
  checksumSha256   String?            @map("checksum_sha256")
  description      String?
  uploadedById     String?            @map("uploaded_by_id") @db.Uuid
  uploadedAt       DateTime?          @map("uploaded_at")
  deletedAt        DateTime?          @map("deleted_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  receipt    WorkReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([storageKey])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("evidence")
}

model EmailVerificationToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  invalidatedAt DateTime? @map("invalidated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  requestedIp   String?   @map("requested_ip")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model EmailOutbox {
  id                          String              @id @default(uuid()) @db.Uuid
  type                        EmailJobType
  recipientEmail              String              @map("recipient_email")
  recipientName               String?             @map("recipient_name")
  encryptedPayload            String?             @map("encrypted_payload")
  status                      EmailDeliveryStatus @default(PENDING)
  attemptCount                Int                 @default(0) @map("attempt_count")
  maxAttempts                 Int                 @default(8) @map("max_attempts")
  nextAttemptAt               DateTime            @default(now()) @map("next_attempt_at")
  claimedAt                   DateTime?           @map("claimed_at")
  sentAt                      DateTime?           @map("sent_at")
  failedAt                    DateTime?           @map("failed_at")
  providerMessageId           String?             @map("provider_message_id")
  lastErrorCode               String?             @map("last_error_code")
  lastErrorMessageSanitised   String?             @map("last_error_message_sanitised")
  relatedUserId               String?             @map("related_user_id") @db.Uuid
  relatedReceiptId            String?             @map("related_receipt_id") @db.Uuid
  relatedVerificationRequestId String?            @map("related_verification_request_id") @db.Uuid
  createdAt                   DateTime            @default(now()) @map("created_at")
  updatedAt                   DateTime            @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([relatedReceiptId])
  @@index([relatedUserId])
  @@index([type, status])
  @@map("email_outbox")
}

model VerificationRequest {
  id            String                 @id @default(uuid()) @db.Uuid
  receiptId     String                 @map("receipt_id") @db.Uuid
  tokenHash     String                 @unique @map("token_hash")
  attemptNumber Int                    @map("attempt_number")
  method        ConfirmationMethod     @default(EMAIL)
  customerEmail String?                @map("customer_email")
  expiresAt     DateTime               @map("expires_at")
  claimedAt     DateTime?              @map("claimed_at")
  usedAt        DateTime?              @map("used_at")
  invalidatedAt DateTime?              @map("invalidated_at")
  result        ConfirmationDecision?  @map("result")
  createdAt     DateTime               @default(now()) @map("created_at")

  receipt       WorkReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  confirmations Confirmation[]

  @@index([receiptId, attemptNumber])
  @@index([receiptId, createdAt])
  @@index([expiresAt])
  @@map("verification_requests")
}

model Confirmation {
  id                    String               @id @default(uuid()) @db.Uuid
  receiptId             String               @map("receipt_id") @db.Uuid
  verificationRequestId String?              @map("verification_request_id") @db.Uuid
  attemptNumber         Int                  @map("attempt_number")
  method                ConfirmationMethod   @default(EMAIL)
  decision              ConfirmationDecision
  customerName          String               @map("customer_name")
  customerEmail         String?              @map("customer_email")
  comment               String?
  confirmedAt           DateTime             @default(now()) @map("confirmed_at")
  ipAddress             String?              @map("ip_address")
  userAgent             String?              @map("user_agent")

  receipt             WorkReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  verificationRequest VerificationRequest? @relation(fields: [verificationRequestId], references: [id], onDelete: SetNull)

  @@index([receiptId, confirmedAt])
  @@index([receiptId, attemptNumber])
  @@map("confirmations")
}

model Dispute {
  id           String        @id @default(uuid()) @db.Uuid
  receiptId    String        @unique @map("receipt_id") @db.Uuid
  reason       String
  description  String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  openedAt     DateTime      @default(now()) @map("opened_at")
  resolvedAt   DateTime?     @map("resolved_at")
  resolvedById String?       @map("resolved_by_id") @db.Uuid

  receipt    WorkReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  resolvedBy User?       @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@map("disputes")
}

model ReceiptEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  receiptId     String                 @map("receipt_id") @db.Uuid
  actorId       String?                @map("actor_id") @db.Uuid
  actorType     ReceiptEventActorType  @map("actor_type")
  eventType     String                 @map("event_type")
  fromStatus    ReceiptStatus?         @map("from_status")
  toStatus      ReceiptStatus?         @map("to_status")
  publicSummary String?                @map("public_summary")
  metadata      Json?
  ipAddress     String?                @map("ip_address")
  createdAt     DateTime               @default(now()) @map("created_at")

  receipt WorkReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  actor   User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([receiptId, createdAt])
  @@index([eventType])
  @@map("receipt_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  receiptId  String?  @map("receipt_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor   User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  receipt WorkReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([receiptId])
  @@index([createdAt])
  @@map("audit_logs")
}
