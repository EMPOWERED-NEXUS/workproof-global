generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WORKER
  ORGANISATION
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ReceiptStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  CORRECTION_REQUESTED
  DISPUTED
  REVOKED
  ARCHIVED
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum EvidenceType {
  IMAGE
  DOCUMENT
  LINK
}

enum ConfirmationDecision {
  CONFIRMED
  CORRECTION_REQUESTED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  role         UserRole   @default(WORKER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  workerProfile WorkerProfile?
  organisation  Organisation?
  receipts      WorkReceipt[]  @relation("WorkerReceipts")
  auditLogs     AuditLog[]

  @@map("users")
}

model WorkerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  headline    String?
  bio         String?
  location    String?
  phone       String?
  skills      String[] @default([])
  profileSlug String   @unique @map("profile_slug")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_profiles")
}

model Organisation {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @unique @map("owner_id") @db.Uuid
  name        String
  description String?
  website     String?
  location    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("organisations")
}

model WorkReceipt {
  id                 String        @id @default(uuid()) @db.Uuid
  receiptNumber      String?       @unique @map("receipt_number")
  workerId           String        @map("worker_id") @db.Uuid
  customerName       String        @map("customer_name")
  customerEmail      String        @map("customer_email")
  customerPhone      String?       @map("customer_phone")
  serviceTitle       String        @map("service_title")
  description        String
  workDate           DateTime      @map("work_date") @db.Date
  durationMinutes    Int?          @map("duration_minutes")
  amount             Decimal?      @db.Decimal(12, 2)
  currency           String        @default("XAF")
  skillsDemonstrated String[]      @default([]) @map("skills_demonstrated")
  status             ReceiptStatus @default(DRAFT)
  visibility         Visibility    @default(PRIVATE)
  verificationCode   String?       @unique @map("verification_code")
  integrityHash      String?       @map("integrity_hash")
  submittedAt        DateTime?     @map("submitted_at")
  verifiedAt         DateTime?     @map("verified_at")
  lockedAt           DateTime?     @map("locked_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  worker              User                 @relation("WorkerReceipts", fields: [workerId], references: [id], onDelete: Cascade)
  evidence            Evidence[]
  verificationRequest VerificationRequest?
  confirmation        Confirmation?
  dispute             Dispute?
  auditLogs           AuditLog[]

  @@index([workerId])
  @@index([status])
  @@index([workDate])
  @@map("work_receipts")
}

model Evidence {
  id               String       @id @default(uuid()) @db.Uuid
  receiptId        String       @map("receipt_id") @db.Uuid
  type             EvidenceType
  url              String
  originalFilename String?      @map("original_filename")
  mimeType         String?      @map("mime_type")
  size             Int?
  description      String?
  createdAt        DateTime     @default(now()) @map("created_at")

  receipt WorkReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("evidence")
}

model VerificationRequest {
  id            String    @id @default(uuid()) @db.Uuid
  receiptId     String    @unique @map("receipt_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  customerEmail String    @map("customer_email")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  receipt WorkReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("verification_requests")
}

model Confirmation {
  id            String               @id @default(uuid()) @db.Uuid
  receiptId     String               @unique @map("receipt_id") @db.Uuid
  decision      ConfirmationDecision
  customerName  String               @map("customer_name")
  customerEmail String               @map("customer_email")
  comment       String?
  confirmedAt   DateTime             @default(now()) @map("confirmed_at")
  ipAddress     String?              @map("ip_address")
  userAgent     String?              @map("user_agent")

  receipt WorkReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("confirmations")
}

model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  receiptId   String        @unique @map("receipt_id") @db.Uuid
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  openedAt    DateTime      @default(now()) @map("opened_at")
  resolvedAt  DateTime?     @map("resolved_at")

  receipt WorkReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("disputes")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  receiptId  String?  @map("receipt_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor   User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  receipt WorkReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([receiptId])
  @@index([createdAt])
  @@map("audit_logs")
}
