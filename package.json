{
  "name": "workproof-global",
  "version": "0.1.0",
  "description": "WorkProof Global — worker-owned proof-of-work platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@workproof/api",
    "dev:web": "npm run dev --workspace=@workproof/web",
    "dev:mobile": "npm run start --workspace=@workproof/mobile",
    "start:mobile": "npm run start --workspace=@workproof/mobile",
    "android": "npm run android --workspace=@workproof/mobile",
    "mobile:clear": "npm run clear --workspace=@workproof/mobile",
    "build:shared": "npm run build --workspace=@workproof/shared",
    "build": "npm run db:generate && npm run build:shared && npm run build --workspace=@workproof/api && npm run build --workspace=@workproof/web",
    "lint": "npm run lint --workspace=@workproof/web",
    "typecheck": "npm run db:generate && npm run typecheck --workspace=@workproof/shared && npm run build:shared && npm run typecheck --workspace=@workproof/api && npm run typecheck --workspace=@workproof/web && npm run typecheck --workspace=@workproof/mobile",
    "typecheck:mobile": "npm run typecheck --workspace=@workproof/mobile",
    "test": "npm run db:generate && npm run build:shared && npm run test --workspace=@workproof/api",
    "test:api": "npm run db:generate && npm run build:shared && npm run test --workspace=@workproof/api",
    "test:e2e": "npm run test:e2e --workspace=@workproof/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=@workproof/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@workproof/api",
    "db:migrate:status": "npm run db:migrate:status --workspace=@workproof/api",
    "db:generate": "npm run db:generate --workspace=@workproof/api",
    "db:seed": "npm run db:seed --workspace=@workproof/api",
    "db:studio": "npm run db:studio --workspace=@workproof/api",
    "admin:bootstrap": "npm run admin:bootstrap --workspace=@workproof/api",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "docker:build:api": "docker build -f Dockerfile.api -t workproof-api:local .",
    "docker:build:web": "docker build -f Dockerfile.web -t workproof-web:local .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EMPOWERED-NEXUS/workproof-global.git"
  },
  "license": "ISC",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
